<%#
  Data truyền vào:
  - item: Object {_id, title, category, location, startDate, bannerUrl, price}
%>
<div class="ticket-card">
  <div class="ticket-card__media">
    <img src="<%= item.bannerUrl || 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=600&q=80' %>" alt="<%= item.title %>">
    <span class="ticket-card__stamp"><%= item.category %></span>
  </div>

  <div class="ticket-card__divider"></div>

  <div class="ticket-card__body">
    <h5 class="ticket-card__title"><%= item.title %></h5>

    <p class="ticket-card__meta">
      <i class="bi bi-geo-alt-fill"></i><%= item.location %>
    </p>
    <p class="ticket-card__meta mb-3">
      <i class="bi bi-calendar-event"></i>
      <%= new Date(item.startDate).toLocaleDateString('vi-VN') %>
    </p>

    <div class="ticket-card__footer">
      <span class="ticket-card__price">
        <% if (item.price === null || typeof item.price === 'undefined') { %>
          Chưa mở bán
        <% } else if (Number(item.price) === 0) { %>
          Miễn phí
        <% } else { %>
          Từ <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(Number(item.price)) %>
        <% } %>
      </span>
      <a href="/events/<%= item._id %>" class="btn-stub">Chi tiết</a>
    </div>
  </div>
</div>
