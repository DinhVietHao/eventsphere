<nav class="navbar navbar-expand-lg navbar-dark navbar-ticket perforated-bottom sticky-top">
  <div class="container">
    <a class="navbar-brand" href="/events">
      <span class="brand-mark"><i class="bi bi-ticket-perforated-fill"></i></span>
      <span class="brand-word">Event<b>Sphere</b></span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="d-flex align-items-center gap-2 ms-auto">
        <% if (typeof user !=='undefined' && user) { %>
          <% const displayName=user.name || 'Lỗi' ; %>
          <div class="dropdown">
            <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" href="#"
               role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="avatar-chip me-2">
                <%= displayName.charAt(0).toUpperCase() %>
              </div>
              <span class="d-none d-sm-inline fw-semibold">
                  <%= displayName %>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Tài khoản</a></li>
              <% if (user.role==='attendee' ) { %>
                <li>
                  <a class="dropdown-item" href="/tickets">
                    <i class="bi bi-ticket-perforated me-1"></i>
                    Vé của tôi
                  </a>
                </li>
              <% } %>
              <% if (user.role==='staff' || user.role==='admin' ) { %>
                <li>
                  <a class="dropdown-item" href="/staff/checkin">
                    <i class="bi bi-qr-code-scan me-2"></i>Soát vé (Check-in)
                  </a>
                </li>
              <% } %>
              <% if (user.role==='admin' || user.role==='organizer' ) { %>
                <li><a class="dropdown-item" href="/organizer/dashboard"><i
                            class="bi bi-speedometer2 me-2"></i>Quản lý</a></li>
              <% } %>
              <% if (user.role==='admin' ) { %>
                <li><a class="dropdown-item" href="/admin/dashboard"><i
                            class="bi bi-shield-check me-2"></i>Admin
                    Panel</a></li>
              <% } %>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item text-danger" href="/logout"><i
                          class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/login" class="btn-ticket-ghost">Đăng nhập</a>

          <div class="dropdown">
            <button class="btn-ticket-solid dropdown-toggle" type="button" id="registerDropdown"
                    data-bs-toggle="dropdown" aria-expanded="false">
              Đăng ký
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="registerDropdown">
              <li>
                <a class="dropdown-item" href="/register?role=attendee">
                  <i class="bi bi-person-badge me-2"></i>
                  Người tham dự (Attendee)
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/register?role=organizer">
                  <i class="bi bi-megaphone me-2"></i>
                  Nhà tổ chức (Organizer)
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
