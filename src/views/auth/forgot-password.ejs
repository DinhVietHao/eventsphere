<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quên mật khẩu - EventSphere</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/theme.css" rel="stylesheet">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    .auth-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 1.25rem 1.5rem;
    }

    .auth-card {
      width: 100%;
      max-width: 440px;
      background: var(--paper-raised);
      border-radius: var(--radius-lg);
      box-shadow: 0 40px 70px -36px rgba(18, 20, 28, 0.28);
      padding: 2.75rem 2.5rem;
    }

    .auth-card__icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: var(--indigo-soft);
      color: var(--indigo);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin-bottom: 1.25rem;
    }

    .form-control:focus {
      border-color: var(--indigo);
      box-shadow: 0 0 0 0.2rem rgba(67, 56, 202, 0.15);
    }
  </style>
</head>

<body>

  <div class="auth-topbar">
    <a href="/login" class="btn-stub"><i class="bi bi-arrow-left me-1"></i>Về đăng nhập</a>
  </div>

  <div class="auth-card">
    <div class="auth-card__icon"><i class="bi bi-key-fill"></i></div>
    <h3 class="fw-bold mb-1" style="font-family:var(--font-display);">Quên mật khẩu?</h3>
    <p class="text-muted small mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu cho bạn.</p>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert flash-ticket is-danger mb-3">
      <span class="flash-ticket__icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
      <div class="flash-ticket__msg"><%= error %></div>
    </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert flash-ticket mb-3">
      <span class="flash-ticket__icon"><i class="bi bi-check-circle-fill"></i></span>
      <div class="flash-ticket__msg"><%= success %></div>
    </div>
    <% } %>

    <form action="/forgot-password" method="POST" id="forgotForm">
      <div class="mb-4">
        <label for="email" class="form-label small fw-semibold text-secondary">Địa chỉ Email</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
          <input type="email" class="form-control bg-light border-start-0" id="email" name="email" required placeholder="name@example.com">
        </div>
      </div>

      <button type="submit" class="btn-ticket-solid w-100 py-2 d-flex align-items-center justify-content-center" id="submitBtn">
        <span id="btnText">Gửi link đặt lại mật khẩu</span>
        <div class="spinner-border spinner-border-sm ms-2 d-none" id="btnSpinner" role="status"></div>
      </button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('forgotForm').addEventListener('submit', function() {
      const btn = document.getElementById('submitBtn');
      const text = document.getElementById('btnText');
      const spin = document.getElementById('btnSpinner');
      btn.disabled = true;
      text.textContent = 'Đang gửi...';
      spin.classList.remove('d-none');
    });
  </script>
</body>

</html>
