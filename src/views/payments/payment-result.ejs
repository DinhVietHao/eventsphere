<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5 text-center">
          <% if (result.checksumValid===false) { %>
            <div class="text-danger display-5 mb-3">
              <i class="bi bi-shield-x"></i>
            </div>
            <h1 class="h4 fw-bold mb-2">Thanh toán không hợp lệ</h1>
            <p class="text-muted mb-4">VNPay không hợp lệ. Vui lòng không tải lại giao dịch này.</p>
            <a href="/events" class="btn btn-outline-primary">Quay lại danh sách sự kiện</a>
            <% } else if (result.success) { %>
              <div class="text-success display-5 mb-3">
                <i class="bi bi-check-circle-fill"></i>
              </div>
              <h1 class="h4 fw-bold mb-2">Thanh toán thành công</h1>
              <p class="text-muted mb-1">Mã đơn hàng: <strong>
                  <%= result.orderCode %>
                </strong></p>
              <% if (result.transactionNo) { %>
                <p class="text-muted mb-4">Mã giao dịch VNPay: <strong>
                    <%= result.transactionNo %>
                  </strong></p>
                <% } %>

                  <% if (result.qrCode) { %>
                    <div class="bg-light rounded border p-4 my-4">
                      <img src="<%= result.qrCode %>" alt="Ticket QR Code"
                        class="img-fluid bg-white p-3 rounded shadow-sm" style="max-width: 280px;">
                      <p class="text-muted small mt-3 mb-0">Xuất trình mã QR này khi check-in.</p>
                    </div>
                    <% } else { %>
                      <div class="alert alert-info text-start my-4">
                        Thanh toán đã thành công. Vé sẽ hiển thị sau khi hệ thống hoàn tất xác nhận.
                      </div>
                      <% } %>

                        <div class="d-flex flex-wrap justify-content-center gap-2">
                          <% if (result.ticketId) { %>
                            <a href="/tickets/<%= result.ticketId %>" class="btn btn-primary">
                              <i class="bi bi-ticket-perforated me-1"></i>Xem chi tiết vé
                            </a>
                            <% } %>
                              <a href="<%= result.eventId ? '/events/' + result.eventId : '/events' %>"
                                class="btn btn-outline-secondary">
                                Quay lại sự kiện
                              </a>
                        </div>
                        <% } else { %>
                          <div class="text-warning display-5 mb-3">
                            <i class="bi bi-x-circle-fill"></i>
                          </div>
                          <h1 class="h4 fw-bold mb-2">Thanh toán thất bại</h1>
                          <p class="text-muted mb-1">Mã đơn hàng: <strong>
                              <%= result.orderCode || "N/A" %>
                            </strong></p>
                          <p class="text-muted mb-4">Mã phản hồi VNPay: <%= result.responseCode || "N/A" %>
                          </p>
                          <div class="d-flex flex-wrap justify-content-center gap-2">
                            <a href="<%= result.eventId ? '/events/' + result.eventId : '/events' %>"
                              class="btn btn-outline-secondary">
                              Quay lại sự kiện
                            </a>
                            <% if (result.registrationId) { %>
                              <form action="/api/v1/payments/vnpay/create" method="POST">
                                <input type="hidden" name="registrationId" value="<%= result.registrationId %>">
                                <input type="hidden" name="language" value="vn">
                                <button type="submit" class="btn btn-primary">Thử lại VNPay</button>
                              </form>
                              <% } %>
                          </div>
                          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>