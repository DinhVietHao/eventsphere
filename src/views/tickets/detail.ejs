<% const event=ticket.eventId || {}; const ticketType=ticket.ticketTypeId || {}; const
  registration=ticket.registrationId || {}; const status=String(ticket.status || "ISSUED" ).toLowerCase(); const
  statusMeta={ issued: { label: "Issued" , className: "bg-success" }, checked_in: { label: "Checked In" ,
  className: "bg-primary" }, expired: { label: "Expired" , className: "bg-danger" }, cancelled: { label: "Cancelled" ,
  className: "bg-secondary" }, }[status] || { label: ticket.status, className: "bg-secondary" }; const
  price=Number(ticketType.price || 0); %>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
              <div>
                <p class="text-uppercase text-muted small fw-bold mb-1">Ticket Details</p>
                <h1 class="h3 fw-bold mb-0">
                  <%= event.title || "Event ticket" %>
                </h1>
              </div>
              <span class="badge <%= statusMeta.className %> px-3 py-2">
                <%= statusMeta.label %>
              </span>
            </div>

            <div class="bg-light rounded-3 border p-3 p-md-4 mb-4">
              <div class="row g-3">
                <div class="col-sm-6">
                  <div class="text-muted small">Ticket type</div>
                  <div class="fw-semibold">
                    <%= ticketType.name || "Standard" %>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="text-muted small">Price</div>
                  <div class="fw-semibold">
                    <%= price> 0 ? price.toLocaleString("vi-VN") + " VND" : "Free" %>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="text-muted small">Start time</div>
                  <div class="fw-semibold">
                    <%= event.startDate ? new Date(event.startDate).toLocaleString("vi-VN") : "Updating" %>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="text-muted small">End time</div>
                  <div class="fw-semibold">
                    <%= event.endDate ? new Date(event.endDate).toLocaleString("vi-VN") : "Updating" %>
                  </div>
                </div>
                <div class="col-12">
                  <div class="text-muted small">Location</div>
                  <div class="fw-semibold">
                    <%= event.location || "Updating" %>
                  </div>
                </div>
              </div>
            </div>

            <div class="text-center mb-4">
              <div class="d-inline-block bg-white border rounded-3 p-3 shadow-sm">
                <img src="<%= ticket.qrCode %>" alt="Ticket QR Code" class="img-fluid"
                  style="width: 240px; max-width: 100%;">
              </div>
              <p class="text-muted small mt-3 mb-0">Show this QR code at check-in.</p>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2">
              <a href="/events" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to events
              </a>
              <a href="/api/v1/tickets/history/me" class="btn btn-primary">
                <i class="bi bi-clock-history me-1"></i>Ticket history
              </a>
            </div>

            <% if (registration.status) { %>
              <p class="text-center text-muted small mt-3 mb-0">
                Registration status: <span class="fw-semibold">
                  <%= registration.status %>
                </span>
              </p>
              <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>