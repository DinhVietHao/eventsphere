<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Vé của tôi</h1>
      <p class="text-muted mb-0">Danh sách các sự kiện bạn đã đăng ký</p>
    </div>
    <a href="/events" class="btn btn-outline-primary">
      <i class="bi bi-search me-1"></i>Khám phá sự kiện
    </a>
  </div>

  <% if (tickets && tickets.length> 0) { %>
    <div class="row g-4">
      <% tickets.forEach((ticket)=> { %>
        <% const event=ticket.eventId || {}; const ticketType=ticket.ticketTypeId || {}; const
          status=ticket.displayStatus || { key: "upcoming" , className: "bg-primary" }; const statusLabelMap={
          upcoming: "Sắp diễn ra" , attended: "Đã tham dự" , cancelled: "Đã hủy" , expired: "Đã hết hạn" , }; const
          statusLabel=statusLabelMap[status.key] || "Sắp diễn ra" ; %>
          <div class="col-12">
            <div class="card border-0 shadow-sm overflow-hidden">
              <div class="row g-0">
                <div class="col-md-4 col-lg-3">
                  <img
                    src="<%= event.bannerUrl || 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=700&q=80' %>"
                    alt="<%= event.title || 'Event banner' %>" class="w-100 h-100 object-fit-cover"
                    style="min-height: 190px;">
                </div>
                <div class="col-md-8 col-lg-9">
                  <div class="card-body p-4 h-100 d-flex flex-column">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                      <div>
                        <h2 class="h5 fw-bold mb-1">
                          <%= event.title || "Event ticket" %>
                        </h2>
                        <div class="text-muted small">
                          <i class="bi bi-ticket-perforated me-1"></i>
                          <%= ticketType.name || "Standard" %>
                        </div>
                      </div>
                      <span class="badge <%= status.className %> px-3 py-2">
                        <%= statusLabel %>
                      </span>
                    </div>

                    <div class="row g-3 mb-4">
                      <div class="col-sm-6">
                        <div class="text-muted small">Thời gian</div>
                        <div class="fw-semibold">
                          <%= event.startDate ? new Date(event.startDate).toLocaleString("vi-VN") : "Đang cập nhật" %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="text-muted small">Địa điểm</div>
                        <div class="fw-semibold">
                          <%= event.location || "Đang cập nhật" %>
                        </div>
                      </div>
                    </div>

                    <div class="mt-auto d-flex flex-wrap justify-content-between align-items-center gap-2">
                      <span class="text-muted small">
                        Mã vé: <span class="fw-semibold">
                          <%= ticket._id %>
                        </span>
                      </span>
                      <a href="/tickets/<%= ticket._id %>" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-eye me-1"></i>
                        Xem chi tiết
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
    </div>
    <% } else { %>
      <div class="bg-white border rounded-3 shadow-sm text-center py-5 px-4">
        <div class="display-4 text-primary mb-3">
          <i class="bi bi-ticket-perforated"></i>
        </div>
        <h2 class="h5 fw-bold mb-2">Bạn chưa có vé nào</h2>
        <p class="text-muted mb-4">Hãy khám phá các sự kiện đang mở đăng ký trên EventSphere.</p>
        <a href="/events" class="btn btn-primary">
          <i class="bi bi-calendar2-event me-1"></i>Khám phá sự kiện
        </a>
      </div>
      <% } %>
</div>