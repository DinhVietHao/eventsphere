<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a href="/organizer/events">Sự kiện của tôi</a></li>
    <li class="breadcrumb-item active">Tạo sự kiện mới</li>
  </ol>
</nav>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<form action="/organizer/events" method="POST" id="eventForm" enctype="multipart/form-data">
  <%# ── PHẦN 1: THÔNG TIN SỰ KIỆN ── %>
  <div class="card border-0 shadow-sm p-4 mb-4">
    <h2 class="h5 fw-bold text-dark mb-4 border-bottom pb-2">
      <i class="bi bi-calendar-event me-2"></i>Thông tin sự kiện
    </h2>
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="mb-3">
          <label class="form-label small fw-bold">Tên sự kiện <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="title" required
            placeholder="Ví dụ: Hội thảo công nghệ TechSphere 2026"
            value="<%= (typeof old !== 'undefined' && old) ? old.title || '' : '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Mô tả chi tiết <span class="text-danger">*</span></label>
          <textarea class="form-control" name="description" rows="8" required
            placeholder="Mô tả nội dung chương trình..."><%= (typeof old !== 'undefined' && old) ? old.description || '' : '' %></textarea>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="mb-3">
          <label class="form-label small fw-bold">Danh mục <span class="text-danger">*</span></label>
          <select class="form-select" name="category" required>
            <option value="">-- Chọn danh mục --</option>
            <option value="music"     <%= (typeof old !== 'undefined' && old && old.category === 'music')     ? 'selected' : '' %>>Music</option>
            <option value="tech"      <%= (typeof old !== 'undefined' && old && old.category === 'tech')      ? 'selected' : '' %>>Tech</option>
            <option value="sport"     <%= (typeof old !== 'undefined' && old && old.category === 'sport')     ? 'selected' : '' %>>Sport</option>
            <option value="education" <%= (typeof old !== 'undefined' && old && old.category === 'education') ? 'selected' : '' %>>Education</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Địa điểm <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="location" required
            placeholder="Tòa nhà, tên đường, Quận/Thành phố..."
            value="<%= (typeof old !== 'undefined' && old) ? old.location || '' : '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Banner sự kiện</label>
          <input type="file" class="form-control" name="banner" accept="image/*">
          <div class="form-text">Ảnh tối đa 5MB.</div>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Ngày bắt đầu <span class="text-danger">*</span></label>
          <input type="datetime-local" class="form-control" id="startDate" name="startDate" required
            value="<%= (typeof old !== 'undefined' && old) ? old.startDate || '' : '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Ngày kết thúc <span class="text-danger">*</span></label>
          <input type="datetime-local" class="form-control" id="endDate" name="endDate" required
            value="<%= (typeof old !== 'undefined' && old) ? old.endDate || '' : '' %>">
        </div>
      </div>
    </div>
  </div>

  <%# ── PHẦN 2: LOẠI VÉ ── %>
  <div class="card border-0 shadow-sm p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
      <h2 class="h5 fw-bold text-dark mb-0">
        <i class="bi bi-ticket-perforated me-2"></i>Loại vé
        <span class="text-danger">*</span>
        <span class="text-muted small fw-normal ms-2">(bắt buộc ít nhất 1 loại vé)</span>
      </h2>
      <button type="button" class="btn btn-outline-primary btn-sm" onclick="addTicketRow()">
        <i class="bi bi-plus-lg me-1"></i>Thêm loại vé
      </button>
    </div>

    <% const oldTickets = (typeof old !== 'undefined' && old && old.tickets && old.tickets.length) ? old.tickets : [{}]; %>
    <div id="ticketList">
      <% oldTickets.forEach(function (t, idx) { %>
        <div class="ticket-row card bg-light border-0 p-3 mb-3" data-index="<%= idx %>">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="row-label fw-bold small text-muted">Loại vé #<%= idx + 1 %></span>
            <button type="button" class="btn btn-outline-danger btn-sm remove-btn <%= oldTickets.length === 1 ? 'd-none' : '' %>" onclick="removeTicketRow(this)">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="form-label small fw-bold">Tên loại vé <span class="text-danger">*</span></label>
              <input type="text" class="form-control form-control-sm" name="ticketName[]" required
                placeholder="VD: General, VIP..." value="<%= t.name || '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-bold">Giá (VNĐ) <span class="text-danger">*</span></label>
              <input type="number" class="form-control form-control-sm" name="ticketPrice[]" required min="0"
                placeholder="0 = Miễn phí" value="<%= (t.price !== undefined && t.price !== '') ? t.price : '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-bold">Số lượng <span class="text-danger">*</span></label>
              <input type="number" class="form-control form-control-sm" name="ticketQuota[]" required min="1"
                placeholder="VD: 100" value="<%= (t.quota !== undefined && t.quota !== '') ? t.quota : '' %>">
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-bold">Mô tả quyền lợi</label>
              <input type="text" class="form-control form-control-sm" name="ticketDescription[]"
                placeholder="Không bắt buộc" value="<%= t.description || '' %>">
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <%# ── NÚT SUBMIT ── %>
  <div class="d-flex justify-content-end gap-2 mb-4">
    <input type="hidden" name="actionType" id="actionType" value="draft">
    <a href="/organizer/events" class="btn btn-outline-secondary px-4">Hủy</a>
    <button type="button" class="btn btn-outline-secondary px-4" onclick="submitAs('draft')">
      Lưu bản nháp
    </button>
    <button type="button" class="btn btn-primary px-4 fw-bold" onclick="submitAs('submit')">
      <i class="bi bi-send me-2"></i>Gửi duyệt sự kiện
    </button>
  </div>
</form>

<script>
  let ticketCount = <%= oldTickets.length %>;

  function addTicketRow() {
    ticketCount++;
    const list = document.getElementById('ticketList');
    const row = document.createElement('div');
    row.className = 'ticket-row card bg-light border-0 p-3 mb-3';
    row.innerHTML = `
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="row-label fw-bold small text-muted">Loại vé #${ticketCount}</span>
        <button type="button" class="btn btn-outline-danger btn-sm remove-btn" onclick="removeTicketRow(this)">
          <i class="bi bi-trash"></i>
        </button>
      </div>
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label small fw-bold">Tên loại vé <span class="text-danger">*</span></label>
          <input type="text" class="form-control form-control-sm" name="ticketName[]" required placeholder="VD: General, VIP...">
        </div>
        <div class="col-md-3">
          <label class="form-label small fw-bold">Giá (VNĐ) <span class="text-danger">*</span></label>
          <input type="number" class="form-control form-control-sm" name="ticketPrice[]" required min="0" placeholder="0 = Miễn phí">
        </div>
        <div class="col-md-3">
          <label class="form-label small fw-bold">Số lượng <span class="text-danger">*</span></label>
          <input type="number" class="form-control form-control-sm" name="ticketQuota[]" required min="1" placeholder="VD: 100">
        </div>
        <div class="col-md-3">
          <label class="form-label small fw-bold">Mô tả quyền lợi</label>
          <input type="text" class="form-control form-control-sm" name="ticketDescription[]" placeholder="Không bắt buộc">
        </div>
      </div>`;
    list.appendChild(row);
    updateRemoveButtons();
  }

  function removeTicketRow(btn) {
    const rows = document.querySelectorAll('.ticket-row');
    if (rows.length <= 1) return;
    btn.closest('.ticket-row').remove();
    renumberRows();
    updateRemoveButtons();
  }

  function renumberRows() {
    document.querySelectorAll('.ticket-row .row-label').forEach((label, i) => {
      label.textContent = `Loại vé #${i + 1}`;
    });
  }

  function updateRemoveButtons() {
    const rows = document.querySelectorAll('.ticket-row');
    rows.forEach(row => {
      const btn = row.querySelector('.remove-btn');
      if (btn) btn.classList.toggle('d-none', rows.length === 1);
    });
  }

  function submitAs(type) {
    document.getElementById('actionType').value = type;
    document.getElementById('eventForm').submit();
  }

  (function () {
    const min24h = new Date(Date.now() + 24 * 60 * 60 * 1000);
    min24h.setSeconds(0, 0);
    const minVal = min24h.toISOString().slice(0, 16);
    document.getElementById('startDate').min = minVal;
    document.getElementById('endDate').min = minVal;
    document.getElementById('startDate').addEventListener('change', function () {
      document.getElementById('endDate').min = this.value;
    });
  })();
</script>
