<% const msgs = typeof messages !== 'undefined' ? messages : { success: [], error: [] }; %>
<% if (msgs.error && msgs.error.length > 0) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  <i class="bi bi-exclamation-triangle me-2"></i><%= msgs.error[0] %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>
<% if (msgs.success && msgs.success.length > 0) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="bi bi-check-circle me-2"></i><%= msgs.success[0] %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0">Quản lý sự kiện của tôi</h1>
  <a href="/organizer/events/create" class="btn btn-primary fw-bold"><i class="bi bi-plus-lg me-2"></i>Tạo sự kiện mới</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 text-nowrap">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4">Banner</th>
          <th>Tên Sự Kiện</th>
          <th>Danh mục</th>
          <th>Trạng thái</th>
          <th>Thời gian</th>
          <th>Đăng ký</th>
          <th class="pe-4 text-end">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if(events && events.length > 0) { %>
        <% events.forEach(item => { %>
        <tr>
          <td class="ps-4">
            <img src="<%= item.bannerUrl || 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=100&q=80' %>" class="rounded object-fit-cover" style="width: 60px; height: 40px;" alt="Banner">
          </td>
          <td class="fw-semibold">
            <a href="/organizer/events/<%= item._id %>" class="text-decoration-none text-dark">
              <%= item.title %>
            </a>
          </td>
          <td><span class="badge bg-light text-dark text-uppercase"><%= item.category %></span></td>
          <td>
            <% if(item.status === 'DRAFT') { %><span class="badge bg-secondary">DRAFT</span>
            <% } else if(item.status === 'PENDING') { %><span class="badge bg-warning text-dark">PENDING</span>
            <% } else if(item.status === 'APPROVED') { %><span class="badge bg-success">APPROVED</span>
            <% } else if(item.status === 'REJECTED') { %><span class="badge bg-danger">REJECTED</span>
            <% } else { %><span class="badge bg-dark">CANCELLED</span><% } %>
          </td>
          <td><small class="text-muted"><%= new Date(item.startDate).toLocaleDateString('vi-VN') %></small></td>
          <td><a href="/organizer/events/<%= item._id %>/registrations" class="text-decoration-none fw-bold"><i class="bi bi-people-fill me-1"></i> <%= item.registrationsCount || 0 %></a></td>
          <td class="pe-4 text-end">
            <div class="btn-group btn-group-sm">
              <a href="/organizer/events/<%= item._id %>/edit" class="btn btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a>
              <a href="/organizer/events/<%= item._id %>/registrations" class="btn btn-outline-info" title="Danh sách đăng ký"><i class="bi bi-card-list"></i></a>
              <form action="/organizer/events/<%= item._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn chắc chắn có muốn xóa sự kiện này? Thao tác không thể khôi phục!');">
                <button type="submit" class="btn btn-outline-danger rounded-start-0" title="Xóa"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
        <% } else { %>
        <tr>
          <td colspan="7" class="text-center py-5 text-muted">Bạn chưa tạo sự kiện nào. Hãy nhấn nút để tạo ngay!</td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>