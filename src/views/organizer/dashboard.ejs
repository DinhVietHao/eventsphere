<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0">Bảng điều khiển tổng quan</h1>
  <span class="text-muted small"><i class="bi bi-clock-history me-1"></i> Cập nhật: Hôm nay</span>
</div>

<div class="row g-4 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-muted small text-uppercase mb-1fw-bold">Tổng sự kiện</h6>
          <h3 class="fw-bold text-dark mb-0"><%= events.length %></h3>
        </div>
        <div class="bg-primary-subtle text-primary rounded p-3"><i class="bi bi-calendar-event fs-4"></i></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-muted small text-uppercase mb-1fw-bold">Đang diễn ra</h6>
          <h3 class="fw-bold text-success mb-0">
            <%= events.filter(e => e.status === 'APPROVED' || e.status === 'ONGOING').length %>
          </h3>
        </div>
        <div class="bg-success-subtle text-success rounded p-3"><i class="bi bi-play-circle fs-4"></i></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-muted small text-uppercase mb-1fw-bold">Tổng Người tham dự</h6>
          <h3 class="fw-bold text-info mb-0">1,248</h3>
        </div>
        <div class="bg-info-subtle text-info rounded p-3"><i class="bi bi-people fs-4"></i></div>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-muted small text-uppercase mb-1fw-bold">Doanh thu</h6>
          <h3 class="fw-bold text-danger mb-0">45.2M đ</h3>
        </div>
        <div class="bg-danger-subtle text-danger rounded p-3"><i class="bi bi-wallet2 fs-4"></i></div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom-0 py-3 d-flex justify-content-between align-items-center">
    <h5 class="fw-bold text-dark mb-0">Sự kiện vừa cập nhật</h5>
    <a href="/organizer/events" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 text-nowrap">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th class="ps-4">Tên sự kiện</th>
          <th>Trạng thái</th>
          <th>Ngày bắt đầu</th>
          <th class="pe-4">Số lượt đăng ký</th>
        </tr>
      </thead>
      <tbody>
        <% if(events && events.length > 0) { %>
        <% events.slice(0, 5).forEach(item => { %>
        <tr>
          <td class="ps-4 fw-semibold text-dark"><%= item.title %></td>
          <td>
            <% if(item.status === 'DRAFT') { %><span class="badge bg-secondary">Bản nháp</span>
            <% } else if(item.status === 'PENDING') { %><span class="badge bg-warning text-dark">Chờ duyệt</span>
            <% } else if(item.status === 'APPROVED') { %><span class="badge bg-success">Đã duyệt</span>
            <% } else if(item.status === 'REJECTED') { %><span class="badge bg-danger">Từ chối</span>
            <% } else { %><span class="badge bg-dark">Hủy bỏ</span><% } %>
          </td>
          <td><%= new Date(item.startDate).toLocaleDateString('vi-VN') %></td>
          <td class="pe-4"><i class="bi bi-person me-1"></i> <%= item.registrationsCount || 0 %></td>
        </tr>
        <% }) %>
        <% } else { %>
        <tr>
          <td colspan="4" class="text-center py-4 text-muted">Chưa có sự kiện nào được khởi tạo.</td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>