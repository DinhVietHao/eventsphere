<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 fw-bold text-dark mb-0"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard tổng quan hệ thống</h1>
  <span class="text-muted small"><i class="bi bi-clock-history me-1"></i>Cập nhật: Hôm nay</span>
</div>

<%# Stat cards %>
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small text-uppercase fw-bold mb-1">Tổng người dùng</p>
          <h3 class="fw-bold text-dark mb-0"><%= stats.users.total %></h3>
          <small class="text-muted">
            <span class="text-primary"><%= stats.users.attendee %> attendee</span> ·
            <span class="text-success"><%= stats.users.organizer %> organizer</span>
          </small>
        </div>
        <div class="bg-primary-subtle text-primary rounded p-3"><i class="bi bi-people fs-4"></i></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small text-uppercase fw-bold mb-1">Tổng sự kiện</p>
          <h3 class="fw-bold text-dark mb-0"><%= stats.events.total %></h3>
          <small class="text-muted">
            <span class="text-warning"><%= stats.events.pending %> chờ duyệt</span> ·
            <span class="text-success"><%= stats.events.approved %> đã duyệt</span>
          </small>
        </div>
        <div class="bg-success-subtle text-success rounded p-3"><i class="bi bi-calendar-event fs-4"></i></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small text-uppercase fw-bold mb-1">Vé đã bán</p>
          <h3 class="fw-bold text-dark mb-0"><%= stats.tickets.totalPaid %></h3>
          <small class="text-muted">đã thanh toán</small>
        </div>
        <div class="bg-warning-subtle text-warning rounded p-3"><i class="bi bi-ticket-perforated fs-4"></i></div>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <p class="text-muted small text-uppercase fw-bold mb-1">Tổng check-in</p>
          <h3 class="fw-bold text-dark mb-0"><%= stats.checkins.total %></h3>
          <small class="text-muted">toàn hệ thống</small>
        </div>
        <div class="bg-info-subtle text-info rounded p-3"><i class="bi bi-person-check fs-4"></i></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <%# Sự kiện chờ duyệt %>
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-hourglass-split text-warning me-2"></i>Sự kiện chờ duyệt</h5>
        <a href="/admin/events/pending" class="btn btn-sm btn-outline-warning">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light text-muted small text-uppercase">
            <tr>
              <th class="ps-3">Tên sự kiện</th>
              <th>Danh mục</th>
              <th>Ngày tạo</th>
              <th class="pe-3 text-end">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentPendingEvents && stats.recentPendingEvents.length > 0) { %>
            <% stats.recentPendingEvents.forEach(event => { %>
            <tr>
              <td class="ps-3 fw-semibold text-dark small"><%= event.title %></td>
              <td><span class="badge bg-light text-dark text-uppercase"><%= event.category %></span></td>
              <td><small class="text-muted"><%= new Date(event.createdAt).toLocaleDateString('vi-VN') %></small></td>
              <td class="pe-3 text-end">
                <a href="/admin/events/<%= event._id %>/detail" class="btn btn-sm btn-outline-primary">Xem</a>
              </td>
            </tr>
            <% }) %>
            <% } else { %>
            <tr>
              <td colspan="4" class="text-center py-4 text-muted small">Không có sự kiện nào chờ duyệt.</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%# User mới đăng ký %>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-plus text-primary me-2"></i>Người dùng mới</h5>
        <a href="/admin/users" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
      </div>
      <ul class="list-group list-group-flush">
        <% if (stats.recentUsers && stats.recentUsers.length > 0) { %>
        <% stats.recentUsers.forEach(u => { %>
        <li class="list-group-item px-3 py-2 d-flex align-items-center gap-3">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:34px;height:34px;font-size:0.8rem;font-weight:bold;">
            <%= u.name.charAt(0).toUpperCase() %>
          </div>
          <div class="flex-grow-1 min-width-0">
            <div class="fw-semibold text-dark small text-truncate"><%= u.name %></div>
            <div class="text-muted" style="font-size:0.75rem;"><%= u.email %></div>
          </div>
          <span class="badge <%= u.role === 'organizer' ? 'bg-success-subtle text-success' : 'bg-primary-subtle text-primary' %> border">
            <%= u.role %>
          </span>
        </li>
        <% }) %>
        <% } else { %>
        <li class="list-group-item text-center py-4 text-muted small">Chưa có người dùng nào.</li>
        <% } %>
      </ul>
    </div>
  </div>
</div>
