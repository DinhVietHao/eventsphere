<%
// filters = req.query, truyền từ controller (xem hướng dẫn cuối file chat)
const f = typeof filters !== 'undefined' && filters ? filters : {};
const chipUrl = (cat) => {
  const params = new URLSearchParams();
  if (f.keyword) params.set('keyword', f.keyword);
  if (f.startFrom) params.set('startFrom', f.startFrom);
  if (f.startTo) params.set('startTo', f.startTo);
  if (cat) params.set('category', cat);
  const qs = params.toString();
  return '/events' + (qs ? ('?' + qs) : '');
};
%>
<div class="container">

  <!-- HERO: the page opens as one giant ticket -->
  <div class="ticket-hero mb-5">
    <div class="ticket-hero__main">
      <div class="ticket-hero__eyebrow">Vé điện tử · QR check-in</div>
      <h1 class="ticket-hero__title">Khám phá sự kiện tiếp theo của bạn</h1>

      <div class="search-ticket">
        <i class="bi bi-search text-muted"></i>
        <input type="search" name="keyword" form="filterForm" value="<%= f.keyword || '' %>"
               placeholder="Nhập tên sự kiện, từ khóa bạn quan tâm...">
        <button type="submit" form="filterForm">Tìm kiếm</button>
      </div>

      <div class="chip-row">
        <a href="<%= chipUrl('') %>" class="chip-ticket <%= !f.category ? 'is-active' : '' %>">Tất cả</a>
        <a href="<%= chipUrl('music') %>" class="chip-ticket <%= f.category==='music' ? 'is-active' : '' %>">Music</a>
        <a href="<%= chipUrl('tech') %>" class="chip-ticket <%= f.category==='tech' ? 'is-active' : '' %>">Tech</a>
        <a href="<%= chipUrl('sport') %>" class="chip-ticket <%= f.category==='sport' ? 'is-active' : '' %>">Sport</a>
        <a href="<%= chipUrl('education') %>" class="chip-ticket <%= f.category==='education' ? 'is-active' : '' %>">Education</a>
      </div>
    </div>

    <div class="ticket-hero__stub d-none d-md-flex">
      <span class="stub-eyebrow">Admit One</span>
      <i class="bi bi-qr-code stub-icon"></i>
      <span class="stub-serial">EVENTSPHERE · No. 000128</span>
    </div>
  </div>

  <div class="row g-4">

    <aside class="col-lg-3">
      <div class="card border-0 shadow-sm sticky-lg-top" style="top: 16px; border-radius: var(--radius-md);">
        <div class="card-header bg-white py-3 border-bottom-0" style="border-radius: var(--radius-md) var(--radius-md) 0 0;">
          <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-filter-left me-2"></i>Bộ lọc tìm kiếm</h5>
        </div>
        <div class="card-body">
          <!-- 1 form duy nhất: input keyword ở hero (bên trên) submit chung vào form này qua thuộc tính form="filterForm" -->
          <form action="/events" method="GET" id="filterForm">
            <div class="mb-3">
              <label for="category" class="form-label small fw-bold text-secondary">Danh mục</label>
              <select class="form-select" id="category" name="category">
                <option value="" <%= !f.category ? 'selected' : '' %>>Tất cả danh mục</option>
                <option value="music" <%= f.category==='music' ? 'selected' : '' %>>Music</option>
                <option value="tech" <%= f.category==='tech' ? 'selected' : '' %>>Tech</option>
                <option value="sport" <%= f.category==='sport' ? 'selected' : '' %>>Sport</option>
                <option value="education" <%= f.category==='education' ? 'selected' : '' %>>Education</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="startDate" class="form-label small fw-bold text-secondary">Từ ngày</label>
              <input type="date" class="form-select" id="startDate" name="startFrom" value="<%= f.startFrom || '' %>">
            </div>

            <div class="mb-4">
              <label for="endDate" class="form-label small fw-bold text-secondary">Đến ngày</label>
              <input type="date" class="form-select" id="endDate" name="startTo" value="<%= f.startTo || '' %>">
            </div>

            <button type="submit" class="btn btn-primary w-100">Áp dụng lọc</button>
            <% if (f.keyword || f.category || f.startFrom || f.startTo) { %>
              <a href="/events" class="btn btn-outline-secondary w-100 mt-2">Xóa bộ lọc</a>
            <% } %>
          </form>
        </div>
      </div>
    </aside>

    <section class="col-lg-9">
      <div class="section-head">
        <div>
          <div class="eyebrow mb-1">Đang diễn ra</div>
          <h2>Sự kiện nổi bật</h2>
        </div>
        <div class="tear-line"></div>
      </div>

      <% if (f.keyword || f.category || f.startFrom || f.startTo) { %>
        <p class="text-muted small mb-3">
          <i class="bi bi-funnel-fill me-1"></i>Đang lọc:
          <% if (f.keyword) { %><span class="fw-semibold text-dark">"<%= f.keyword %>"</span><% } %>
          <% if (f.category) { %> · danh mục <span class="fw-semibold text-dark"><%= f.category %></span><% } %>
          <% if (f.startFrom) { %> · từ <span class="fw-semibold text-dark"><%= f.startFrom %></span><% } %>
          <% if (f.startTo) { %> · đến <span class="fw-semibold text-dark"><%= f.startTo %></span><% } %>
        </p>
      <% } %>

      <% if (events && events.length> 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% events.forEach(item=> { %>
            <div class="col">
              <%- include('../partials/event-card.ejs', { item: item }) %>
            </div>
          <% }) %>
        </div>

        <%- include('../partials/pagination.ejs', { filters: f }) %>

      <% } else { %>
        <div class="text-center py-5 bg-white rounded shadow-sm">
          <i class="bi bi-calendar-x text-muted display-1"></i>
          <p class="mt-3 text-muted">Hiện tại không có sự kiện nào diễn ra.</p>
        </div>
      <% } %>
    </section>

  </div>
</div>
