<% if (!event) { %>
  <div class="container">
    <div class="alert flash-ticket is-danger mb-3" role="alert">
      <span class="flash-ticket__icon"><i class="bi bi-exclamation-lg"></i></span>
      <div class="flash-ticket__msg"><%= error || 'Khong the tai thong tin su kien.' %></div>
    </div>
    <a href="/events" class="btn btn-outline-primary rounded-pill">
      <i class="bi bi-arrow-left me-1"></i>Quay lai danh sach su kien
    </a>
  </div>
<% } else { %>
  <% const eventStartAt = new Date(event.startDate); const hasEventStarted = Date.now() >= eventStartAt.getTime(); const canRegisterForEvent = event.status === 'APPROVED' && !hasEventStarted; %>
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 border-bottom pb-3 mb-4">
              <div>
                <a href="/events/<%= event._id %>" class="text-decoration-none small fw-semibold" style="color: var(--indigo);">
                  <i class="bi bi-arrow-left me-1"></i>Chi tiết sự kiện
                </a>
                <h1 class="h4 fw-bold text-dark mt-2 mb-1">
                  <%= event.title %>
                </h1>
                <p class="text-muted mb-0 small">
                  <i class="bi bi-calendar-event me-1" style="color: var(--indigo);"></i>
                  <%= new Date(event.startDate).toLocaleString('vi-VN') %>
                  <span class="mx-2">|</span>
                  <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                  <%= event.location %>
                </p>
              </div>
            </div>

            <% if (error) { %>
              <div class="alert flash-ticket is-danger mb-3" role="alert">
                <span class="flash-ticket__icon"><i class="bi bi-exclamation-lg"></i></span>
                <div class="flash-ticket__msg"><%= error %></div>
              </div>
            <% } %>

            <% if (registrationResult) { %>
              <% if (registrationResult.nextStep==='ticket_issued' ) { %>
                <div class="alert flash-ticket mb-4" role="alert">
                  <span class="flash-ticket__icon"><i class="bi bi-check-lg"></i></span>
                  <div class="flash-ticket__msg">
                    <div class="fw-bold">Đã đăng ký thành công</div>
                    <div class="small text-muted">Vé QR đã được tạo và gửi đến email của bạn.</div>
                  </div>
                  <a href="/tickets/<%= registrationResult.ticket._id %>"
                     class="btn btn-sm rounded-pill fw-semibold px-3 text-white" style="background: var(--success); border: none;">
                    Xem chi tiết vé <i class="bi bi-arrow-right-short ms-1"></i>
                  </a>
                </div>

                <div class="ticket-row mb-4 overflow-hidden">
                  <div class="row g-0">
                    <div class="col-md-4">
                      <div class="ticket-row__media d-flex align-items-center justify-content-center p-3" style="background: var(--paper);">
                        <img src="<%= registrationResult.ticket.qrCode %>" alt="Ticket QR Code"
                             class="img-fluid" style="max-width: 200px;">
                      </div>
                    </div>
                    <div class="col-md-8 d-flex">
                      <div class="ticket-row__divider d-none d-md-block"></div>
                      <div class="p-4 d-flex flex-column justify-content-center flex-grow-1">
                        <span class="price-stub__label mb-2">Mã vé</span>
                        <div class="qr-ticket__code"><%= registrationResult.ticket._id %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% } else if (!canRegisterForEvent) { %>
                Sự kiện hiện không còn cho phép đăng ký hoặc mua vé.
              <% } else { %>
                <div class="alert flash-ticket mb-4" style="border-left-color: var(--amber);" role="alert">
                          <span class="flash-ticket__icon" style="background: var(--amber-soft2); color: #a3690f;">
                            <i class="bi bi-credit-card-fill"></i>
                          </span>
                  <div class="flash-ticket__msg flex-grow-1">
                    <div class="fw-bold mb-1">Cần thanh toán vé</div>
                    <p class="mb-2 small">Registration đã được tạo với trạng thái pending_payment.</p>
                    <span class="fw-bold d-block mb-3">
                              Số tiền:
                              <%= registrationResult.payment.amount.toLocaleString('vi-VN') %>
                      <%= registrationResult.payment.currency %>
                            </span>
                    <% if (canRegisterForEvent) { %>
                    <form action="/api/v1/payments/vnpay/create" method="POST">
                      <input type="hidden" name="registrationId"
                             value="<%= registrationResult.registration._id %>">
                      <input type="hidden" name="language" value="vn">
                      <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                          <label for="bankCode" class="form-label small fw-bold">Bank</label>
                          <select id="bankCode" name="bankCode" class="form-select">
                            <option value="">VNPay default</option>
                            <option value="NCB">NCB</option>
                          </select>
                        </div>
                        <div class="col-md-4 d-grid">
                          <button type="submit" class="btn btn-primary rounded-pill">
                            Thanh toán qua VNPay
                          </button>
                        </div>
                      </div>
                    </form>
                    <% } else { %>
                      <div class="alert flash-ticket is-danger mb-0" role="alert">
                        <span class="flash-ticket__icon"><i class="bi bi-exclamation-lg"></i></span>
                        <div class="flash-ticket__msg">Sự kiện đã bắt đầu hoặc đã kết thúc. Bạn không thể đăng ký hoặc mua vé.</div>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% } %>
            <% } %>

            <% if (!registrationResult && canRegisterForEvent) { %>
              <form action="/events/<%= event._id %>/booking" method="POST">
                <div class="section-head">
                  <div><span class="eyebrow">Bước 1</span><h2 class="h6 fw-bold mb-0 mt-1">Chọn loại vé</h2></div>
                  <div class="tear-line"></div>
                </div>

                <% if (ticketTypes && ticketTypes.length> 0) { %>
                  <div class="row g-3 mb-4">
                    <% ticketTypes.forEach(ticketType=> { %>
                      <% const sold=typeof ticketType.soldQuantity !=='undefined' ?
                              ticketType.soldQuantity : ticketType.sold; const
                              remaining=Math.max(ticketType.quota - sold, 0); const isSoldOut=remaining <=0;
                        const isSelected=selectedTicketTypeId &&
                                selectedTicketTypeId.toString()===ticketType._id.toString(); %>
                      <div class="col-md-6">
                        <label class="tier-card <%= isSelected ? 'is-selected' : '' %> <%= isSoldOut ? 'is-soldout' : '' %>">
                          <div class="form-check">
                            <input class="form-check-input" type="radio" name="ticketTypeId"
                                   value="<%= ticketType._id %>" <%=isSelected ? 'checked' : '' %>
                                    <%= isSoldOut ? 'disabled' : 'required' %>>
                            <div class="ms-2">
                              <div class="d-flex justify-content-between align-items-start gap-2">
                                <h3 class="h6 fw-bold text-dark mb-1">
                                  <%= ticketType.name %>
                                </h3>
                                <% if (isSoldOut) { %>
                                  <span class="badge rounded-pill" style="background: var(--ink-faint);">Hết vé</span>
                                <% } else { %>
                                  <span class="badge rounded-pill" style="background: var(--success);">Còn <%= remaining %></span>
                                <% } %>
                              </div>
                              <p class="text-muted small mb-3">
                                <%= ticketType.description || 'Vé tham dự sự kiện' %>
                              </p>
                              <div class="tier-card__price">
                                <%= ticketType.price===0 ? 'Miễn phí' :
                                        ticketType.price.toLocaleString('vi-VN') + ' VND' %>
                              </div>
                            </div>
                          </div>
                        </label>
                      </div>
                    <% }) %>
                  </div>

                  <button type="submit" class="btn btn-primary btn-lg px-4 fw-bold rounded-pill">
                    <i class="bi bi-ticket-perforated-fill me-2"></i>Đăng ký tham dự
                  </button>
                <% } else { %>
                  <div class="alert flash-ticket mb-0" style="border-left-color: var(--indigo);" role="alert">
                                      <span class="flash-ticket__icon" style="background: var(--indigo-soft); color: var(--indigo);">
                                        <i class="bi bi-info-lg"></i>
                                      </span>
                    <div class="flash-ticket__msg">Sự kiện này chưa có loại vé nào.</div>
                  </div>
                <% } %>
              </form>
            <% } else if (!registrationResult) { %>
              <div class="alert flash-ticket is-danger mb-0" role="alert">
                <span class="flash-ticket__icon"><i class="bi bi-exclamation-lg"></i></span>
                <div class="flash-ticket__msg">
                  <% if (event.status === 'PENDING' || event.status === 'DRAFT') { %>
                    Sự kiện hiện chưa mở đăng ký.
                  <% } else if (event.status === 'CANCELLED') { %>
                    Sự kiện đã bị hủy. Bạn không thể đăng ký hoặc mua vé.
                  <% } else { %>
                    Sự kiện đã bắt đầu hoặc đã kết thúc. Bạn không thể đăng ký hoặc mua vé.
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <aside class="col-lg-4">
        <div class="card border-0 shadow-sm sticky-lg-top overflow-hidden" style="top: 16px;">
          <img
                  src="<%= event.bannerUrl || 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=900&q=80' %>"
                  class="card-img-top object-fit-cover" alt="<%= event.title %>" style="height: 170px;">
          <div class="card-body">
            <h2 class="h6 fw-bold text-dark mb-3">
              <%= event.title %>
            </h2>
            <p class="text-muted small mb-2">
              <i class="bi bi-calendar-check-fill me-2" style="color: var(--indigo);"></i>
              <%= new Date(event.startDate).toLocaleString('vi-VN') %>
            </p>
            <p class="text-muted small mb-3">
              <i class="bi bi-geo-alt-fill text-danger me-2"></i>
              <%= event.location %>
            </p>
            <div class="price-stub__divider" style="margin: 1rem -1rem;"></div>
            <p class="small text-muted mb-0 pt-2">
              <% if (registrationResult && registrationResult.nextStep==='payment_required' ) { %>
                Trạng thái tiếp theo: thanh toán vé.
              <% } else if (registrationResult) { %>
                Giữ mã QR này để check-in tại cổng sự kiện.
              <% } else { %>
                Hãy chọn một loại vé còn quota để hoàn tất đăng ký.
              <% } %>
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
<% } %>
