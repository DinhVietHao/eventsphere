<div class="container">
  <div class="row justify-content-center mb-5">
    <div class="col-lg-8">
      <div class="text-center mb-3">
        <div class="ticket-hero__eyebrow justify-content-center">Vé điện tử · QR check-in</div>
        <h2 class="fw-bold text-dark">Tìm sự kiện phù hợp với bạn</h2>
      </div>
      <form action="/events/search" method="GET" class="search-ticket">
        <i class="bi bi-search text-muted"></i>
        <input type="search" name="keyword" value="<%= keyword || '' %>" placeholder="Nhập tên sự kiện, từ khóa bạn quan tâm..." aria-label="Search">
        <button type="submit">Tìm kiếm</button>
      </form>
      <% if (keyword) { %>
        <p class="text-muted mt-3 small text-center">Kết quả tìm kiếm cho từ khóa: <strong class="text-primary">"<%= keyword %>"</strong></p>
      <% } %>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-10">
      <% if (events && events.length > 0) { %>

        <% events.forEach(item => { %>
          <div class="ticket-row mb-4 overflow-hidden">
            <div class="row g-0">
              <div class="col-md-4">
                <div class="ticket-row__media">
                  <img src="<%= item.bannerUrl || 'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=600&q=80' %>" alt="<%= item.title %>">
                </div>
              </div>
              <div class="col-md-8 d-flex">
                <div class="ticket-row__divider d-none d-md-block"></div>
                <div class="p-4 d-flex flex-column flex-grow-1">
                  <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                    <h4 class="h5 fw-bold text-dark mb-0"><%= item.title %></h4>
                    <span class="ticket-card__stamp position-relative top-0 start-0" style="color: var(--indigo); border-color: var(--indigo); background: var(--indigo-soft); backdrop-filter:none;"><%= item.category %></span>
                  </div>

                  <p class="text-muted small mb-2">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= item.location %>
                  </p>
                  <p class="text-muted small mb-3">
                    <i class="bi bi-calendar2-week text-primary me-1"></i><%= new Date(item.startDate).toLocaleDateString('vi-VN') %>
                  </p>

                  <div class="mt-auto d-flex align-items-center justify-content-between pt-3 border-top">
                    <span class="ticket-card__price fs-5"><%= item.price === 0 || !item.price ? 'Miễn phí' : item.price.toLocaleString('vi-VN') + ' đ' %></span>
                    <a href="/events/<%= item._id %>" class="btn btn-primary px-4 btn-sm rounded-pill">Xem chi tiết</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>

      <% } else { %>
        <div class="text-center py-5 bg-white rounded shadow-sm">
          <i class="bi bi-search-heart text-muted display-1"></i>
          <h3 class="h5 fw-bold text-dark mt-4">Không tìm thấy kết quả phù hợp</h3>
          <p class="text-muted small">Hãy thử tìm kiếm lại bằng một từ khóa khác hoặc kiểm tra lại chính tả.</p>
          <a href="/events" class="btn btn-outline-primary btn-sm mt-2 px-4 rounded-pill">Quay lại trang sự kiện</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
