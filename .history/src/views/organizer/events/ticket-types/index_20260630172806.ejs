<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/organizer/events">Sự kiện</a></li>
        <li class="breadcrumb-item active">Loại vé — <%= event.title %>
        </li>
    </ol>
</nav>

<% if (messages.success && messages.success.length) { %>
    <div class="alert alert-success">
        <%= messages.success[0] %>
    </div>
    <% } %>
        <% if (messages.error && messages.error.length) { %>
            <div class="alert alert-danger">
                <%= messages.error[0] %>
            </div>
            <% } %>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Loại vé — <%= event.title %>
                    </h4>
                    <% if (['DRAFT','PENDING'].includes(event.status)) { %>
                        <a href="/organizer/events/<%= event._id %>/ticket-types/create" class="btn btn-primary">+ Thêm
                            loại vé</a>
                        <% } %>
                </div>

                <div class="card border-0 shadow-sm">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên loại vé</th>
                                <th>Giá</th>
                                <th>Quota</th>
                                <th>Đã bán</th>
                                <th>Còn lại</th>
                                <th>Mô tả</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (ticketTypes.length===0) { %>
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        Chưa có loại vé nào. <a
                                            href="/organizer/events/<%= event._id %>/ticket-types/create">Thêm ngay</a>
                                    </td>
                                </tr>
                                <% } %>
                                    <% ticketTypes.forEach(tt=> { %>
                                        <tr>
                                            <td class="fw-bold">
                                                <%= tt.name %>
                                            </td>
                                            <td>
                                                <%= tt.price===0 ? '<span class="badge bg-success">Miễn phí</span>' :
                                                    tt.price.toLocaleString('vi-VN') + 'đ' %>
                                            </td>
                                            <td>
                                                <%= tt.quota %>
                                            </td>
                                            <td>
                                                <%= tt.sold %>
                                            </td>
                                            <td>
                                                <%= tt.quota - tt.sold %>
                                            </td>
                                            <td class="text-muted small">
                                                <%= tt.description || '—' %>
                                            </td>
                                            <td>
                                                <% if (['DRAFT','PENDING'].includes(event.status)) { %>
                                                    <a href="/organizer/events/<%= event._id %>/ticket-types/<%= tt._id %>/edit"
                                                        class="btn btn-sm btn-outline-secondary me-1">Sửa</a>
                                                    <form
                                                        action="/organizer/events/<%= event._id %>/ticket-types/<%= tt._id %>/delete"
                                                        method="POST" class="d-inline"
                                                        onsubmit="return confirm('Xóa loại vé này?')">
                                                        <button class="btn btn-sm btn-outline-danger" <%=tt.sold> 0 ?
                                                            'disabled title="Đã có người mua"' : '' %>>
                                                            Xóa
                                                        </button>
                                                    </form>
                                                    <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>
                </div>