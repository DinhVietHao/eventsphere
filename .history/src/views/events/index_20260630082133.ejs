<div class="container">
  <div class="row g-4">

    <aside class="col-lg-3">
      <div class="card border-0 shadow-sm sticky-lg-top" style="top: 80px;">
        <div class="card-header bg-white py-3 border-bottom-0">
          <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-filter-left me-2"></i>Bộ lọc tìm kiếm</h5>
        </div>
        <div class="card-body">
          <form action="/events" method="GET">
            <div class="mb-3">
              <label for="category" class="form-label small fw-bold text-secondary">Danh mục</label>
              <select class="form-select" id="category" name="category">
                <option value="">Tất cả danh mục</option>
                <option value="music">Music</option>
                <option value="tech">Tech</option>
                <option value="sport">Sport</option>
                <option value="education">Education</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="startDate" class="form-label small fw-bold text-secondary">Từ ngày</label>
              <input type="date" class="form-select" id="startDate" name="startFrom">
            </div>

            <div class="mb-4">
              <label for="endDate" class="form-label small fw-bold text-secondary">Đến ngày</label>
              <input type="date" class="form-select" id="endDate" name="endDate">
            </div>

            <button type="submit" class="btn btn-primary w-100">Áp dụng lọc</button>
          </form>
        </div>
      </div>
    </aside>

    <section class="col-lg-9">
      <h2 class="h4 fw-bold mb-4 text-dark">Sự kiện nổi bật</h2>

      <% if (events && events.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% events.forEach(item => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm hover-shadow transition">
            <div class="position-relative">
              <img src="<%= item.bannerUrl || 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=600&q=80' %>" class="card-img-top object-fit-cover" alt="<%= item.title %>" style="height: 180px;">
              <span class="position-absolute top-0 end-0 m-2 badge bg-primary text-uppercase px-2 py-1"><%= item.category %></span>
            </div>

            <div class="card-body d-flex flex-column">
              <h5 class="card-title h6 fw-bold text-dark text-truncate-2" style="height: 44px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= item.title %>
              </h5>

              <p class="card-text text-muted small mb-2 text-truncate">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i><%= item.location %>
              </p>

              <p class="card-text text-muted small mb-3">
                <i class="bi bi-calendar-event text-primary me-1"></i>
                <%= new Date(item.startDate).toLocaleDateString('vi-VN') %>
              </p>

              <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                <span class="fw-bold text-primary"><%= item.price === 0 || !item.price ? 'Miễn phí' : item.price.toLocaleString('vi-VN') + ' đ' %></span>
                <a href="/events/<%= item._id %>" class="btn btn-sm btn-outline-primary px-3">Chi tiết</a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <%- include('../partials/pagination.ejs') %>

      <% } else { %>
      <div class="text-center py-5 bg-white rounded shadow-sm">
        <i class="bi bi-calendar-x text-muted display-1"></i>
        <p class="mt-3 text-muted">Hiện tại không có sự kiện nào diễn ra.</p>
      </div>
      <% } %>
    </section>

  </div>
</div>